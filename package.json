{
  "name": "schedulae",
  "version": "1.0.0",
  "description": "Simple timetabling app for small schools",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test 'tests/*.test.js'",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "docker:run": "docker run -p 3000:3000 ghcr.io/iankulin/schedulae",
    "docker:push": "./docker-push.sh"
  },
  "keywords": [
    "timetable",
    "scheduling",
    "education"
  ],
  "license": "GPL-3.0",
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
